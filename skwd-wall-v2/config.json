{
  "components": {
    "wallpaperSelector": {
      "enabled": true,
      "lastAppliedKey": "static:Toothless/N6Ml5pg4-fond-decran-Toothless-9.png",
      "startPosition": "applied"
    }
  },
  "defaultMatugenConfig": "~/.config/matugen/config.toml",
  "externalMatugenCommand": "matugen -c %config% image %path% --source-color-index 0",
  "features": {
    "matugen": true
  },
  "general": {
    "closeOnSelection": true,
    "maxFps": 60,
    "notifyOnWallpaperChange": false,
    "randomRotate": false
  },
  "keys": {
    "tagCloud": "/"
  },
  "monitor": "HDMI-A-2",
  "performance": {
    "autoDeleteImageTrash": false,
    "batterySaver": false,
    "batteryVideoIdleSeconds": 60,
    "gpuDevice": "uuid:86801219060000000002000000000000",
    "gpuPreference": "auto",
    "imageOptimizeResolution": "1080p"
  },
  "plasma": {
    "lockScreen": {
      "mode": "static"
    }
  },
  "tagging": {
    "defaultSearchMode": "describe"
  },
  "theme": {
    "authority": "skwd",
    "engine": "matugen"
  },
  "transition": {
    "shader": "iris"
  },
  "wallhaven": {
    "defaults": {
      "anime": false
    }
  }
}
