/* ROFI VERTICAL THEME - MATUGEN */

* {
    font:               "JetBrains Mono 12";
    background-color:   transparent;
    text-color:         var(text-color);
    accent-color:       var(accent-color);
    margin:     0px;
    padding:    0px;
    spacing:    0px;
}
window {
    background-color:   rgba(0, 0, 0, 0.4);
    border-color:       var(primary-color);
    location:   center;
    width:      480px;
    border:     1px;
    border-radius:      10px;
}
mainbox {
    background-color:   transparent;
    children:           [ inputbar, listview ];
}
inputbar {
    background-color:   transparent;
    border:             0px;
    padding:            8px 12px;
    spacing:            12px;
    children:           [ prompt, entry ];
}
separator {
    height:             0px;
    border:             0px;
    background-color:   transparent;
}
prompt {
    vertical-align:     0.5;
    text-color:         var(primary-color);
}
entry {
    vertical-align:     0.5;
    text-color:         var(text-color);
    background-color:   transparent;
}
listview {
    lines:              8;
    columns:            1;
    fixed-height:       false;
    background-color:   transparent;
    scrollbar:          false;
    border:             0px;
    padding:            4px;
    spacing:            2px;
}
element {
    padding:            8px;
    spacing:            8px;
    background-color:   transparent;
    border-radius:      8px;
    text-color:         var(text-color);
}
element normal normal {
    background-color:   transparent;
    text-color:         var(text-color);
}
element alternate normal {
    background-color:   transparent;
    text-color:         var(text-color);
}
element normal urgent {
    background-color:   transparent;
    text-color:         var(error-color);
}
element normal active {
    background-color:   transparent;
    text-color:         var(primary-color);
}
element alternate urgent {
    background-color:   transparent;
    text-color:         var(error-color);
}
element alternate active {
    background-color:   transparent;
    text-color:         var(primary-color);
}
element selected normal {
    background-color:   var(primary-container-color);
    text-color:         var(on-primary-container-color);
    border-radius:      8px;
}
element selected urgent {
    background-color:   var(error-container-color);
    text-color:         var(on-primary-container-color);
    border-radius:      8px;
}
element selected active {
    background-color:   var(primary-container-color);
    text-color:         var(on-primary-container-color);
    border-radius:      8px;
}
element-icon {
    vertical-align:     0.5;
    size:               0.75em;
    background-color:   transparent;
}
element-text {
    vertical-align:     0.5;
    background-color:   transparent;
    text-color:         inherit;
}
