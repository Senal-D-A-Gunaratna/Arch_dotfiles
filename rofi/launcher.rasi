/* ROFI VERTICAL THEME - MATUGEN */
@theme "~/.config/matugen/themes/colors.rasi"

* {
    font:               "JetBrains Mono 12";
    background-color:   transparent;
    text-color:         @text-color;
    accent-color:       @accent-color;
    margin:     0px;
    padding:    0px;
    spacing:    0px;
}
window {
    background-color:   rgba(0, 0, 0, 0.3);
    border-color:       @primary-color;
    location:   center;
    width:      480px;
    border:     1px;
    border-radius:      10px;
}
inputbar {
    background-color:   rgba(0, 0, 0, 0);
    padding:    8px 12px;
    spacing:    12px;
    children:   [ prompt, entry ];
}
prompt, entry, element-text, element-icon {
    vertical-align: 0.5;
}
prompt {
    text-color: @primary-color;
}
listview {
    lines:      8;
    columns:    1;
    fixed-height:   false;
    background-color: transparent;
}
element {
    padding:    8px;
    spacing:    8px;
    background-color: transparent;
}
element normal urgent {
    text-color: @error-color;
}
element normal active {
    text-color: @primary-color;
}
element alternate active {
    text-color: @primary-color;
}
element selected {
    text-color: @on-primary-container-color;
}
element selected normal {
    background-color:   @primary-container-color;
}
element selected urgent {
    background-color:   @error-container-color;
}
element selected active {
    background-color:   @primary-container-color;
}
element-icon {
    size:   0.75em;
}
element-text {
    text-color: inherit;
    background-color: transparent;
}
