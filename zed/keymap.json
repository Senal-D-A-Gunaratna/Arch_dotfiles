[
  // ==========================================
  // 1. GLOBAL LAYOUT, PANES & PANELS (LazyVim Style)
  // ==========================================
  {
    "context": "Workspace",
    "bindings": {
      // Focus navigation across ALL panels (File Tree, Terminal, Code)
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",

      // Panel toggles matching LazyVim keys
      "space e": "workspace::ToggleLeftDock", // Toggle Neo-tree / Project Panel
      "space f t": "workspace::ToggleBottomDock", // Toggle ToggleTerm / Terminal Panel
      "space a": "workspace::ToggleRightDock" // Toggle Copilot/Assistant Panel
    }
  },

  // ==========================================
  // 2. BUFFER / TAB SWITCHING (FIXED SCOPE)
  // ==========================================
  {
    "context": "Editor && VimControl && !VimWaiting",
    "bindings": {
      // Shift + h / l inside the editor to cleanly cycle open code files
      "H": "pane::ActivatePreviousItem",
      "L": "pane::ActivateNextItem",

      // Close active buffer
      "space b d": "pane::CloseActiveItem"
    }
  },

  // ==========================================
  // 3. CORE LAZYVIM LEADER KEY SEQUENCES
  // ==========================================
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      // Find (Telescope / File Picker equivalents)
      "space f f": "file_finder::Toggle", // Find Files (<leader>ff)
      "space s f": "file_finder::Toggle", // Alternate find files
      "space f r": "projects::OpenRecent", // Recent Files (<leader>fr)
      "space /": "workspace::NewSearch", // Global search in project (<leader>/)
      "space s s": "outline::Toggle", // Document Symbols / Outline (<leader>ss)

      // Git mappings
      "space g g": "workspace::ToggleBottomDock", // Fallback toggle for integrated Git terminals

      // Code / LSP Actions
      "g d": "editor::GoToDefinition", // LSP Go to Definition
      "g r": "editor::FindAllReferences", // LSP Find References
      "g I": "editor::GoToImplementation", // LSP Go to Implementation
      "g y": "editor::GoToTypeDefinition", // LSP Go to Type Definition
      "g ]": "editor::GoToDiagnostic", // FIXED: Next Diagnostic Error/Warning
      "g [": "editor::GoToPreviousDiagnostic", // FIXED: Prev Diagnostic Error/Warning
      "space c a": "editor::ToggleCodeActions", // Code Actions (<leader>ca)
      "space c r": "editor::Rename" // LSP Rename Symbol (<leader>cr)
    }
  },

  // ==========================================
  // 4. VISUAL INDENT RETENTION
  // ==========================================
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      // Keep block selected while indenting
      ">": "editor::Indent",
      "<": "editor::Outdent"
    }
  }
]
