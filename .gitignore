# 1. Global Ignore
/*

# 2. Allow the ignore file itself
!.gitignore

# 3. Simple Directories (Whole folder tracked)
!README.md
!mpv
!yazi
!qt6ct
!matugen
!scripts
!xsettingsd
!gpu-screen-recorder
!kwalletrc
!user-dirs.dirs
!nwg-look
!(stuff)
!waybar
!rofi
!hypr
!kitty
!.vscode
!autostart
!cspell.json
!.luarc.json
!kdeglobals
!mimeapps.list
!systemd

# 4. Selective Tracking (Riced apps)

#Matugen
!matugen
matugen/themes

# Btop: Track config, ignore themes
!btop
btop/themes
!btop/btop.conf

# GTK: Track folder, ignore generated CSS
!gtk-3.0
!gtk-4.0
gtk-4.0/assets

# Clipse: No logs or history
!clipse
clipse/*
!clipse/config.json

# Dunst: Track only the folder, ignore the main rc if it's auto-generated
!dunst
dunst/dunstrc

# kew
!kew
kew/themes
kew/library.dat

# VSCodium / Code (The logic fix)
!VSCodium
VSCodium/*
!VSCodium/User
VSCodium/User/*
!VSCodium/User/settings.json
!VSCodium/User/keybindings.json

#zed
!zed
zed/themes

#nvim
!nvim
