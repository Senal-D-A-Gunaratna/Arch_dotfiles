# 1. Global Ignore
/*

# 2. Allow the ignore file itself
!.gitignore
!README.md

# 3. Simple Directories (Whole folder tracked)
!mpv/
!yazi/
!qt6ct/
!matugen/
!waypaper/
!calcurse/
!scripts/
!xsettingsd/
!gpu-screen-recorder/
!helix/
!kwalletrc
!user-dirs.dirs

# 4. Selective Tracking (Riced apps)

# Kitty: Track config, ignore matugen colors
!kitty/
kitty/kitty-colors.conf
!kitty/kitty.conf

# Hyprland: Track config, ignore matugen colors
!hypr/
hypr/hyprland-colors.conf

# Rofi
!rofi/
rofi/matugen.rasi

# Waybar
!waybar/
waybar/colors.css

# Btop: Track config, ignore themes
!btop/
btop/themes/
!btop/btop.conf

# GTK: Track folder, ignore generated CSS
!gtk-3.0/
!gtk-4.0/
gtk-3.0/colors.css
gtk-4.0/colors.css
gtk-4.0/assets/

# Clipse: No logs or history
!clipse/
clipse/*
!clipse/config.json

# Dunst: Track only the folder, ignore the main rc if it's auto-generated
!dunst/
dunst/dunstrc

# Termusic
!termusic/
termusic/*
!termusic/tui.toml
!termusic/server.toml

# VSCodium / Code (The logic fix)
!VSCodium/
VSCodium/*
!VSCodium/User/
VSCodium/User/*
!VSCodium/User/settings.json
!VSCodium/User/keybindings.json

!Code/
Code/*
!Code/User/
Code/User/*
!Code/User/settings.json
!Code/User/keybindings.json