* {
    text-color:         {{colors.on_surface.default.hex}};
    accent-color:       {{colors.primary.default.hex}};
    primary-color:      {{colors.primary.default.hex}};
    error-color:        {{colors.error.default.hex}};
    on-primary-container-color: {{colors.on_primary_container.default.hex}};
    primary-container-color:    {{colors.primary_container.default.hex}};
    error-container-color:      {{colors.error_container.default.hex}};
}
