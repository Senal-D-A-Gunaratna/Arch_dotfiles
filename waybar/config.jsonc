{
  "layer": "top",
  "position": "top",
  "height": 22,

  "modules-center": ["hyprland/window"],
  "modules-left": ["hyprland/workspaces", "tray"],

  "modules-right": [
    "custom/media",
    "pulseaudio",
    "custom/monitor_brightness",
    "network",
    "bluetooth",
    "cpu",
    "memory",
    "clock",
  ],

  "hyprland/window": {
    "max-length": 50,
    "separate-outputs": true,
    "tooltip": false,
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "tooltip": false,
    "disable-scroll": true,
  },

  "tray": {
    "icon-size": 18,
    "spacing": 10,
    "tooltip": false,
  },

  "custom/media": {
    "format": " {}",
    "max-length": 40,
    "exec": "playerctl metadata --format '{{title}}' --follow",
    "tooltip": false,
  },

  "custom/monitor_brightness": {
    "format": "{}",
    "exec": "/home/senal/.config/waybar/brightness",
    "return-type": "json",
    "on-scroll-up": "/home/senal/.config/waybar/brightness up && pkill -RTMIN+8 waybar",
    "on-scroll-down": "/home/senal/.config/waybar/brightness down && pkill -RTMIN+8 waybar",
    "signal": 8,
    "tooltip": false,
  },

  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": " muted",
    "tooltip": false,
  },

  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "⚠",
    "tooltip": false,
    "interval": 1,
  },

  "bluetooth": {
    "format": "󰂲",
    "format-connected": "󰋋",
    "format-connected-battery": "󰋋 {device_battery_percentage}%",
    "format-device-preference": ["Mcdodo T03"],
    "tooltip-format": "{device_alias}",
    "tooltip-format-connected-battery": "{device_alias} {device_battery_percentage}%",
    "tooltip": true,
  },

  "cpu": {
    "format": "  {usage}%",
    "tooltip": false,
    "interval": 1,
  },

  "memory": {
    "format": "  {percentage}%",
    "tooltip": false,
    "interval": 1,
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}",
    "tooltip": true,
    "interval": 1,
    "on-click": "kitty --detach calcurse",
  },
}
